# Plantilla de configuracion de PlanifIA para docker compose.
#
#   cp .env.example .env      y rellena al menos las variables marcadas como OBLIGATORIA.
#
# El fichero .env real NO se sube al repositorio (esta en .gitignore): lleva contrasenas y
# la API key. Este es solo el modelo, con valores de ejemplo o vacios.

# ----------------------------------------------------------------- base de datos (Oracle)
# OBLIGATORIA. Contrasena del usuario SYSTEM del contenedor de Oracle.
ORACLE_PASSWORD=cambia-esta-contrasena
# OBLIGATORIAS. Usuario de la aplicacion; el contenedor de Oracle lo crea al arrancar.
DB_USERNAME=kanban
DB_PASSWORD=cambia-esta-contrasena
ORACLE_PORT=1521
# update: Hibernate crea y amplia el esquema solo. validate: no toca nada.
JPA_DDL_AUTO=update

# ----------------------------------------------------------------------- seguridad (JWT)
# OBLIGATORIA. Minimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --------------------------------------------------------- administrador de la plataforma
# Cuenta ADMIN que se crea al arrancar si no hay ningun administrador habilitado.
# OBLIGATORIA. Pon una contrasena propia: es la cuenta con mas permisos de la aplicacion.
ADMIN_EMAIL=admin@planifia.local
ADMIN_PASSWORD=cambia-esta-contrasena

# --------------------------------------------------------------------- IA (DeepSeek)
# Sin API key la aplicacion funciona igual, pero no genera planes ni responde el asistente.
# Se consigue en https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_ENABLED=true
AI_TIMEOUT=5m
# Opcionales. Topes de tokens de cada respuesta (plan, asistente y lectura de imagenes):
# si una respuesta se corta, el propio mensaje de error dice cual subir.
#AI_MAX_OUTPUT_TOKENS=32000
#AI_CHAT_MAX_OUTPUT_TOKENS=1500
#AI_VISION_MAX_OUTPUT_TOKENS=8000
# false: no se manda ninguna imagen a DeepSeek; un PDF escaneado se rechaza explicando por que.
#AI_VISION_ENABLED=true

# ------------------------------------------------------------------- correo de invitaciones
# Por defecto los correos van a Mailpit (http://localhost:8025), que los atrapa sin enviarlos.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@planifia.local
# Donde vive la interfaz: con esto se compone el enlace de las invitaciones.
APP_BASE_URL=http://localhost:3000
MAILPIT_UI_PORT=8025

# ------------------------------------------------------------------------------- varios
BACKEND_PORT=8080
FRONTEND_PORT=3000
TZ=Europe/Madrid
